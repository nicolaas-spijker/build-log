# Copy to .env and fill in your own values. Never commit .env.

# === LLM provider ===
# Which provider the scripts call. Options: anthropic | openai
LLM_PROVIDER=anthropic

# API key for whichever provider you chose above.
# - If LLM_PROVIDER=anthropic, set ANTHROPIC_API_KEY (or LLM_API_KEY).
# - If LLM_PROVIDER=openai, set OPENAI_API_KEY (or LLM_API_KEY).
LLM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model names (override defaults if you want).
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_MODEL=gpt-4o-mini

# === Your site ===
# The blog you are running this pipeline against. No trailing slash.
SITE_BASE_URL=https://example.com
SITE_BLOG_PATH=/blog
SITE_HOST=example.com

# User-Agent string the scraper presents. Be polite.
SCRAPER_USER_AGENT=build-log-scraper/1.0 (+https://example.com)

# === Webflow (optional — only needed for the writing/ push helpers) ===
WEBFLOW_API_TOKEN=
WEBFLOW_SITE_ID=
WEBFLOW_BLOG_COLLECTION_ID=
WEBFLOW_PRIMARY_LOCALE_ID=
WEBFLOW_SECONDARY_LOCALE_ID=

# Reference IDs for required CMS fields on a new article.
# Look these up once in your Webflow CMS and paste them in.
WEBFLOW_DEFAULT_AUTHOR_ID=
WEBFLOW_DEFAULT_CATEGORY_ID=

# === Google APIs (optional — for research/ stubs) ===
# Path to a Google service-account JSON key file. Keep the file OUTSIDE this repo.
GOOGLE_APPLICATION_CREDENTIALS=
GA4_PROPERTY_ID=
GSC_PROPERTY=sc-domain:example.com

# === Image library (optional — only for writing/select_images.py) ===
# Path to the metadata index JSON for your own image library.
# The image binaries are never committed; only this index is read.
IMAGE_INDEX_PATH=
